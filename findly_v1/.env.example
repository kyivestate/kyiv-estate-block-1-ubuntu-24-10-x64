# Keep the authenticated Findly browser cookie outside this repository.
FINDLY_COOKIE_FILE=/secure/path/findly_cookies.txt
FINDLY_PER_PAGE=20
FINDLY_PAGE_DELAY=1.5
FINDLY_REQUEST_TIMEOUT=30
FINDLY_RETRIES=3

# Configure only new, dedicated workbooks. Existing Block 1 sheet IDs must not be used.
GOOGLE_CREDENTIALS_FILE=/secure/path/google_credentials.json
FINDLY_ACTIVE_SHEET_ID=
FINDLY_LIFECYCLE_SHEET_ID=
