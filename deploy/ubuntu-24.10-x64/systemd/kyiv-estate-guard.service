[Unit]
Description=Kyiv Estate Block 1 guard
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=kyivestate
Group=kyivestate
WorkingDirectory=/opt/kyiv-estate-block-1
EnvironmentFile=/etc/kyiv-estate/block-1.env
ExecStart=/opt/kyiv-estate-block-1/scripts_guard.sh
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
