[Unit]
Description=Kyiv Estate Block 2 scheduler
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=kyivestate
Group=kyivestate
WorkingDirectory=/opt/kyiv-estate-block-2
EnvironmentFile=/etc/kyiv-estate/block-2.env
ExecStart=/opt/kyiv-estate-block-2/deploy/ubuntu-24.10-x64/scheduler.sh
Restart=always
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
